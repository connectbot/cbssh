{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^third_party/bouncycastle/upstream\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "org.bouncycastle:bcprov-jdk18on",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)[Dd]ockerfile[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Look up Vanniktech releases by implementation coordinates: Renovate skips Gradle plugin markers on Maven Central",
      "matchManagers": ["gradle"],
      "matchDatasources": ["maven"],
      "matchDepNames": ["com.vanniktech.maven.publish"],
      "overridePackageName": "com.vanniktech:gradle-maven-publish-plugin",
      "registryUrls": ["https://repo.maven.apache.org/maven2"]
    },
    {
      "description": "Keep release workflows on main to match Octo STS job_workflow_ref trust policies",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/release.yml"
      ],
      "matchDepNames": [
        "connectbot/actions",
        "connectbot/actions/**"
      ],
      "enabled": false
    },
    {
      "matchDepNames": ["org.bouncycastle:bcprov-jdk18on"],
      "groupName": "Bouncy Castle and vendored crypto sources",
      "automerge": false,
      "prBodyNotes": [
        "The Bouncy Castle source check compares released upstream files and the reproducible extraction against recorded SHA-256 hashes. If upstream changed, review it against third_party/bouncycastle/upstream.json reviewedVersion, run .github/scripts/vendor_bouncycastle.py --update, review the generated changes, and run the crypto tests. Do not accept new hashes without reviewing the upstream changes."
      ]
    }
  ]
}
