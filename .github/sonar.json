    "sonar.tests": "protocol/src/test/kotlin,sshlib/src/test/kotlin,.github/scripts/test_vendor_sntrup.py",
    "sonar.exclusions": "**/build/generated/**,.github/scripts/test_vendor_sntrup.py",
    "sonar.coverage.exclusions": "testapp/**",
